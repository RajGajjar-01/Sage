# ── LLM Providers (OpenAI-compatible) ──────────────────────────────
# Optional: you can also run /connect in the CLI (or POST /api/v1/providers/connect)
# to add a provider interactively — it's saved to the local database, no .env needed.
# Add API keys for the providers you want to use. Groq is tried first.
GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ENDPOINT=https://api.groq.com/openai/v1/

# ZHIPU_API_KEY also accepts the ZAI_API_KEY alias.
ZHIPU_API_KEY=your-zhipu-key
ZHIPU_MODEL=glm-4.7-flash
ZHIPU_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/

# ── Prompt enhancement ──────────────────────────────────────────────
TAVILY_API_KEY=your-tavily-key

# ── Sandbox ─────────────────────────────────────────────────────────
# All file and shell operations are restricted to this directory.
WORKSPACE=./workspace
DB_PATH=./data/agent.db

# ── Agent loop tuning ───────────────────────────────────────────────
MAX_AGENT_STEPS=25
DOOM_LOOP_THRESHOLD=3
SHELL_TIMEOUT_SECONDS=120
LLM_TIMEOUT_SECONDS=120

# ── API ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000"]
